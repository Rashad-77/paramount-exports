# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables
# (Production and Preview separately; Preview must NOT point at production data).
# Placeholder values only — never commit real credentials.

# --- Database (Supabase Postgres) ---------------------------------------------------------------
# Runtime connection. On Vercel use the Supabase *transaction pooler* string (port 6543).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Direct or session-mode connection, used only for `pnpm db:migrate`, `pnpm create-owner` and `pnpm create-user`.
DATABASE_DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Supabase Auth / Storage --------------------------------------------------------------------
# Safe to expose to the browser (anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Needed for create-owner / create-user and signed uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Security / anti-abuse (used from Step 2) -----------------------------------------------------
# Random string (>= 16 chars) used to hash IP addresses for rate limiting. Generate: openssl rand -hex 24
IP_HASH_SALT=change-me-to-a-long-random-string
# Bearer secret that protects /api/cron/* (Vercel Cron sends it automatically). Generate: openssl rand -hex 24
CRON_SECRET=change-me-to-a-long-random-string
# Optional Cloudflare Turnstile for public forms. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: shows the business's Google rating and reviews on the website. Needs a Google Cloud API key with "Places API (New)" enabled,
# and the business's Place ID saved under Settings. Leave blank to show no Google reviews. Keep it secret: never put it in Settings.
GOOGLE_PLACES_API_KEY=

# --- Public demo on Vercel (no Supabase) ----------------------------------------------------------
# DEMO_DEPLOYMENT=true turns the deployment into a password-less sample-data demo. Only works with a database and NO Supabase
# variables, and stops working once a real business name is saved. See docs/DEMO_DEPLOYMENT.md. Leave unset for a real system.
# DEMO_DEPLOYMENT=false

# --- Development only ----------------------------------------------------------------------------
# DEMO_MODE=true enables (1) `pnpm db:seed` sample data and (2) a development-only sample sign-in so the staff screens
# can be reviewed without Supabase. It only works under `next dev`, never on Vercel or in a production build, and only
# when DATABASE_URL points at localhost. Leave false everywhere else.
DEMO_MODE=false
# Uploads default to Supabase Storage. "local" writes to ./.local-storage for development/tests and is refused on Vercel.
STORAGE_DRIVER=supabase
# LOCAL_STORAGE_DIR=.local-storage

# --- Tests ---------------------------------------------------------------------------------------
# Superuser connection to a THROWAWAY local Postgres for integration tests (each run creates/drops its own database).
# NEVER point this at Supabase or any shared database.
# TEST_ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
