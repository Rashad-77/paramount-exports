{
  "name": "furniture-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Furniture business website + CRM + ERP-lite (modular monolith)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/prepare-e2e-db.ts && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "create-owner": "tsx scripts/create-owner.ts",
    "docs:permissions": "tsx scripts/gen-permissions-doc.ts",
    "storage:setup": "tsx scripts/setup-storage.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.0.4"
  }
}
